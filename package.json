  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.0",
    "typescript": "^5.7.0"
  }
