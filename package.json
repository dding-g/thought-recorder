{
  "name": "thought-recorder",
  "version": "1.0.0",
  "description": "카카오톡 기반 생각 기록 서비스",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
